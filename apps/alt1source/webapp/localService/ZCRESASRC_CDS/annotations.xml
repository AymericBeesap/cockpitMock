                    <Record Type="UI.HeaderInfoType">
                        <PropertyValue Property="TypeName" String="Source d'approvisionnement"/>
                        <PropertyValue Property="TypeNamePlural" String="Sources d'approvisionnement"/>
                        <PropertyValue Property="Title">

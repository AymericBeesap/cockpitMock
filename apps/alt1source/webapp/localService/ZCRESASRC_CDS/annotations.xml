                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="Resultat"/>
                            <PropertyValue Property="Label" String="Approvisionnement retenu"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#GrpResultat"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.FieldGroup" Qualifier="GrpBesoin">
                    <Record Type="UI.FieldGroupType">
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="PurchaseRequisition"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="PurchaseRequisitionItem"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Reservation"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="OriginType"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Plant"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="Material"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="PurchaseRequisitionItemText"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="RequestedQuantity"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="PurReqDate"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="ItemAmount"/></Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.FieldGroup" Qualifier="GrpResultat">
                    <Record Type="UI.FieldGroupType">
                        <PropertyValue Property="Data">
                            <Collection>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="SourceOptionCount"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="SupplierSourceCount"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="SelectedSourceType"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="SelectedSourceName"/></Record>
                                <Record Type="UI.DataField">
                                    <PropertyValue Property="Value" Path="SourceStatus"/>
                                    <PropertyValue Property="Criticality" Path="SourceCriticality"/>
                                </Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="FollowOnDocument"/></Record>
                                <Record Type="UI.DataField"><PropertyValue Property="Value" Path="FollowOnDocumentType"/></Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.Identification">
                    <Collection>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Convertir en commande d'achat"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/ConvertToPurchaseOrder"/>
                            <PropertyValue Property="Determining" Bool="true"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Commande petite caisse"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/CreatePettyCashOrder"/>
                            <PropertyValue Property="Determining" Bool="true"/>
                        </Record>
                        <Record Type="UI.DataFieldForIntentBasedNavigation">
                            <PropertyValue Property="SemanticObject" String="ResaCockpit"/>
                            <PropertyValue Property="Action" String="display"/>
                            <PropertyValue Property="Label" String="Cockpit"/>
                            <PropertyValue Property="RequiresContext" Bool="false"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.PresentationVariant">
                    <Record Type="UI.PresentationVariantType">
                        <PropertyValue Property="SortOrder">
                            <Collection>
                                <Record Type="Common.SortOrderType">
                                    <PropertyValue Property="Property" PropertyPath="PurReqDate"/>
                                    <PropertyValue Property="Descending" Bool="false"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="Visualizations">
                            <Collection>
                                <AnnotationPath>@UI.LineItem</AnnotationPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <!-- Alternative 1 : toutes les DA restant à approvisionner -->
                <Annotation Term="UI.SelectionVariant" Qualifier="ToutesDA">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Toutes les demandes d'achat à approvisionner"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="SourceStatus"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/E"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="CONV"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <!-- Écrans de création : besoins internes au centre (réapprovisionnement manuel) -->
                <Annotation Term="UI.SelectionVariant" Qualifier="ReapproManuel">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Réapprovisionnement manuel du centre"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="OriginType"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="AUTR"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <!-- Alternative 2 : uniquement les réservations -->
                <Annotation Term="UI.SelectionVariant" Qualifier="Reservations">
                    <Record Type="UI.SelectionVariantType">
                        <PropertyValue Property="Text" String="Réservations à approvisionner"/>
                        <PropertyValue Property="SelectOptions">
                            <Collection>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="OriginType"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="RESA"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                                <Record Type="UI.SelectOptionType">
                                    <PropertyValue Property="PropertyName" PropertyPath="SourceStatus"/>
                                    <PropertyValue Property="Ranges">
                                        <Collection>
                                            <Record Type="UI.SelectionRangeType">
                                                <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/E"/>
                                                <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                                                <PropertyValue Property="Low" String="CONV"/>
                                            </Record>
                                        </Collection>
                                    </PropertyValue>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>
            <Annotations Target="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType/SourceCriticality">
                <Annotation Term="UI.Hidden"/>
            </Annotations>
            <Annotations Target="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType/OriginType">

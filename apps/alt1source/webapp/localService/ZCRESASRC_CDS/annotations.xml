<?xml version="1.0" encoding="utf-8"?>
<!-- Reproduit l'annotation service ZCRESASRC_CDS_VAN généré par les extensions de métadonnées
     cds/ZC_ResaPurReqWorklist.asddlxs, cds/ZC_ResaSourceOption.asddlxs et
     cds/ZC_ResaPettyCashOrder.asddlxs. Toute modification doit être reportée dans le CDS. -->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
    <edmx:Reference Uri="/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Vocabularies(TechnicalName='%2FIWBEP%2FVOC_COMMON',Version='0001',SAP__Origin='LOCAL')/$value">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Vocabularies(TechnicalName='%2FIWBEP%2FVOC_UI',Version='0001',SAP__Origin='LOCAL')/$value">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata/sap/ZCRESASRC_CDS/$metadata">
        <edmx:Include Namespace="ZCRESASRC_CDS" Alias="SAP"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema Namespace="ZCRESASRC_CDS_VAN" xmlns="http://docs.oasis-open.org/odata/ns/edm">

            <!-- ============================ liste de travail ============================ -->
            <Annotations Target="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType">
                <Annotation Term="UI.HeaderInfo">
                    <Record Type="UI.HeaderInfoType">
                        <PropertyValue Property="TypeName" String="Poste à approvisionner"/>
                        <PropertyValue Property="TypeNamePlural" String="Postes à approvisionner"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="PurchaseRequisition"/>
                            </Record>
                        </PropertyValue>
                        <PropertyValue Property="Description">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value" Path="PurchaseRequisitionItemText"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>
                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>Plant</PropertyPath>
                        <PropertyPath>OriginType</PropertyPath>
                        <PropertyPath>SourceStatus</PropertyPath>
                        <PropertyPath>Material</PropertyPath>
                        <PropertyPath>Reservation</PropertyPath>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Convertir en commande d'achat"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/ConvertToPurchaseOrder"/>
                            <PropertyValue Property="InvocationGrouping" EnumMember="UI.OperationGroupingType/Isolated"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Commande petite caisse"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/CreatePettyCashOrder"/>
                            <PropertyValue Property="InvocationGrouping" EnumMember="UI.OperationGroupingType/Isolated"/>
                        </Record>
                        <!-- Créations : actions sans contexte ; Fiori elements génère le formulaire
                             de saisie des paramètres du function import. Les deux tuiles de création
                             s'appuient dessus (Alternative 1 : DA seule ; Alternative 2 : DA + CA).
                             Écart assumé de la maquette : le service étant unique, ces boutons
                             apparaissent aussi dans les écrans de détermination. Dans la cible, une
                             vue de consommation par tuile porterait ses propres annotations. -->
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Créer une demande d'achat"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/CreatePurchaseRequisition"/>
                            <PropertyValue Property="RequiresContext" Bool="false"/>
                        </Record>
                        <Record Type="UI.DataFieldForAction">
                            <PropertyValue Property="Label" String="Créer une commande de réapprovisionnement"/>
                            <PropertyValue Property="Action" String="ZCRESASRC_CDS.ZCRESASRC_CDS_Entities/CreateReplenishmentOrder"/>
                            <PropertyValue Property="RequiresContext" Bool="false"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="PurchaseRequisition"/>
                            <PropertyValue Property="Label" String="Demande d'achat"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Reservation"/>
                            <PropertyValue Property="Label" String="Réservation"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="OriginType"/>
                            <PropertyValue Property="Label" String="Origine"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Plant"/>
                            <PropertyValue Property="Label" String="Division"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Material"/>
                            <PropertyValue Property="Label" String="Article"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="PurchaseRequisitionItemText"/>
                            <PropertyValue Property="Label" String="Désignation"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="RequestedQuantity"/>
                            <PropertyValue Property="Label" String="Quantité"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="PurReqDate"/>
                            <PropertyValue Property="Label" String="Date de besoin"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SourceOptionCount"/>
                            <PropertyValue Property="Label" String="Sources"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SupplierSourceCount"/>
                            <PropertyValue Property="Label" String="Dont fournisseurs"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SelectedSourceType"/>
                            <PropertyValue Property="Label" String="Source retenue"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SourceStatus"/>
                            <PropertyValue Property="Label" String="Statut"/>
                            <PropertyValue Property="Criticality" Path="SourceCriticality"/>
                            <Annotation Term="UI.Importance" EnumMember="UI.ImportanceType/High"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="FollowOnDocument"/>
                            <PropertyValue Property="Label" String="Document aval"/>
                        </Record>
                    </Collection>
                </Annotation>
                <Annotation Term="UI.Facets">
                    <Collection>
                        <Record Type="UI.ReferenceFacet">
                            <PropertyValue Property="ID" String="Besoin"/>
                            <PropertyValue Property="Label" String="Besoin"/>
                            <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#GrpBesoin"/>

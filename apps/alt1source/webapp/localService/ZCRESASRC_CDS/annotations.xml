                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="LeadTimeDays"/>
                            <PropertyValue Property="Label" String="Délai (jours)"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="NetPrice"/>
                            <PropertyValue Property="Label" String="Prix"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="SourceId"/>

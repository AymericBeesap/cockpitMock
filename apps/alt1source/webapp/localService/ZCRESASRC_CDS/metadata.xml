<?xml version="1.0" encoding="utf-8"?>
<!-- Service du socle commun de détermination de la source d'approvisionnement.
     Consommé par les quatre applications des deux alternatives. -->
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata" xmlns:sap="http://www.sap.com/Protocols/SAPData">
    <edmx:Reference Uri="/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Vocabularies(TechnicalName='%2FIWBEP%2FVOC_COMMON',Version='0001',SAP__Origin='LOCAL')/$value" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Vocabularies(TechnicalName='%2FIWBEP%2FVOC_UI',Version='0001',SAP__Origin='LOCAL')/$value" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
    </edmx:Reference>
    <edmx:DataServices m:DataServiceVersion="2.0">
        <Schema Namespace="ZCRESASRC_CDS" xml:lang="fr" sap:schema-version="1" xmlns="http://schemas.microsoft.com/ado/2008/09/edm">

            <EntityType Name="ZC_ResaPurReqWorklistType" sap:label="Poste de DA à approvisionner" sap:content-version="1">
                <Key>
                    <PropertyRef Name="PurchaseRequisition"/>
                    <PropertyRef Name="PurchaseRequisitionItem"/>
                </Key>
                <Property Name="PurchaseRequisition" Type="Edm.String" Nullable="false" MaxLength="10" sap:display-format="UpperCase" sap:label="Demande d'achat"/>
                <Property Name="PurchaseRequisitionItem" Type="Edm.String" Nullable="false" MaxLength="5" sap:display-format="NonNegative" sap:label="Poste de DA"/>
                <Property Name="Reservation" Type="Edm.String" MaxLength="20" sap:display-format="UpperCase" sap:label="Réservation"/>
                <Property Name="OriginType" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:text="OriginTypeText" sap:label="Origine"/>
                <Property Name="OriginTypeText" Type="Edm.String" MaxLength="40" sap:label="Libellé origine" sap:filterable="false"/>
                <Property Name="Plant" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:label="Division"/>
                <Property Name="PurchasingGroup" Type="Edm.String" MaxLength="3" sap:display-format="UpperCase" sap:label="Groupe d'acheteurs"/>
                <Property Name="Material" Type="Edm.String" MaxLength="40" sap:display-format="UpperCase" sap:label="Article"/>
                <Property Name="PurchaseRequisitionItemText" Type="Edm.String" MaxLength="40" sap:label="Désignation"/>
                <Property Name="PurReqDate" Type="Edm.DateTime" Precision="0" sap:display-format="Date" sap:label="Date de besoin"/>
                <Property Name="RequestedQuantity" Type="Edm.Decimal" Precision="13" Scale="3" sap:unit="BaseUnit" sap:label="Quantité demandée" sap:filterable="false"/>
                <Property Name="BaseUnit" Type="Edm.String" MaxLength="3" sap:label="Unité" sap:semantics="unit-of-measure"/>
                <Property Name="ItemAmount" Type="Edm.Decimal" Precision="12" Scale="3" sap:unit="Currency" sap:label="Montant" sap:filterable="false"/>
                <Property Name="Currency" Type="Edm.String" MaxLength="5" sap:label="Devise" sap:semantics="currency-code"/>
                <Property Name="PurchaseOrder" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Commande d'achat"/>
                <Property Name="FollowOnDocument" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Document aval"/>
                <Property Name="FollowOnDocumentType" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:label="Type de document aval"/>
                <Property Name="ChainStage" Type="Edm.String" MaxLength="2" sap:display-format="UpperCase" sap:text="ChainStageText" sap:label="Étape"/>
                <Property Name="ChainStageText" Type="Edm.String" MaxLength="40" sap:label="Libellé étape" sap:filterable="false"/>
                <Property Name="SourceOptionCount" Type="Edm.Int32" sap:label="Sources disponibles" sap:filterable="false"/>
                <Property Name="SupplierSourceCount" Type="Edm.Int32" sap:label="Dont fournisseurs" sap:filterable="false"/>
                <Property Name="PettyCashEligible" Type="Edm.Boolean" sap:label="Petite caisse possible" sap:filterable="false"/>
                <Property Name="SelectedSourceType" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:text="SelectedSourceTypeText" sap:label="Type de source retenue"/>
                <Property Name="SelectedSourceTypeText" Type="Edm.String" MaxLength="40" sap:label="Libellé source retenue" sap:filterable="false"/>
                <Property Name="SelectedSourceId" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Source retenue"/>
                <Property Name="SelectedSourceName" Type="Edm.String" MaxLength="80" sap:label="Nom de la source retenue" sap:filterable="false"/>
                <Property Name="SourceStatus" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:text="SourceStatusText" sap:label="Statut"/>
                <Property Name="SourceStatusText" Type="Edm.String" MaxLength="40" sap:label="Libellé statut" sap:filterable="false"/>
                <Property Name="SourceCriticality" Type="Edm.Int32" sap:label="Criticité" sap:filterable="false"/>
                <NavigationProperty Name="to_SourceOption" Relationship="ZCRESASRC_CDS.assoc_WorklistSourceOption" FromRole="FromRole_Worklist" ToRole="ToRole_SourceOption"/>
            </EntityType>

            <EntityType Name="ZC_ResaSourceOptionType" sap:label="Source d'approvisionnement candidate" sap:content-version="1">
                <Key>
                    <PropertyRef Name="SourceOptionId"/>
                </Key>
                <Property Name="SourceOptionId" Type="Edm.String" Nullable="false" MaxLength="70" sap:label="Identifiant de l'option" sap:filterable="false"/>
                <Property Name="PurchaseRequisition" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Demande d'achat"/>
                <Property Name="PurchaseRequisitionItem" Type="Edm.String" MaxLength="5" sap:display-format="NonNegative" sap:label="Poste de DA"/>
                <Property Name="SourceType" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:text="SourceTypeText" sap:label="Type de source"/>
                <Property Name="SourceTypeText" Type="Edm.String" MaxLength="40" sap:label="Libellé du type" sap:filterable="false"/>
                <Property Name="SourceId" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Identifiant"/>
                <Property Name="SourceName" Type="Edm.String" MaxLength="80" sap:label="Source"/>
                <Property Name="Availability" Type="Edm.String" MaxLength="1" sap:display-format="UpperCase" sap:text="AvailabilityText" sap:label="Disponibilité"/>
                <Property Name="AvailabilityText" Type="Edm.String" MaxLength="40" sap:label="Libellé disponibilité" sap:filterable="false"/>
                <Property Name="SourceCriticality" Type="Edm.Int32" sap:label="Criticité" sap:filterable="false"/>
                <Property Name="AvailableQuantity" Type="Edm.Decimal" Precision="13" Scale="3" sap:unit="BaseUnit" sap:label="Quantité disponible" sap:filterable="false"/>
                <Property Name="BaseUnit" Type="Edm.String" MaxLength="3" sap:label="Unité" sap:semantics="unit-of-measure"/>
                <Property Name="LeadTimeDays" Type="Edm.Int32" sap:label="Délai (jours)" sap:filterable="false"/>
                <Property Name="NetPrice" Type="Edm.Decimal" Precision="12" Scale="2" sap:unit="Currency" sap:label="Prix" sap:filterable="false"/>
                <Property Name="Currency" Type="Edm.String" MaxLength="5" sap:label="Devise" sap:semantics="currency-code"/>
                <Property Name="IsSelected" Type="Edm.String" MaxLength="1" sap:label="Retenue" sap:filterable="false"/>
            </EntityType>

            <EntityType Name="ZC_ResaPettyCashOrderType" sap:label="Commande petite caisse" sap:content-version="1">
                <Key>
                    <PropertyRef Name="PettyCashOrder"/>
                </Key>
                <Property Name="PettyCashOrder" Type="Edm.String" Nullable="false" MaxLength="10" sap:display-format="UpperCase" sap:label="N° commande petite caisse"/>
                <Property Name="Reservation" Type="Edm.String" MaxLength="20" sap:display-format="UpperCase" sap:label="Réservation"/>
                <Property Name="PurchaseRequisition" Type="Edm.String" MaxLength="10" sap:display-format="UpperCase" sap:label="Demande d'achat"/>
                <Property Name="PurchaseRequisitionItem" Type="Edm.String" MaxLength="5" sap:display-format="NonNegative" sap:label="Poste de DA"/>
                <Property Name="Plant" Type="Edm.String" MaxLength="4" sap:display-format="UpperCase" sap:label="Division"/>
                <Property Name="Material" Type="Edm.String" MaxLength="40" sap:display-format="UpperCase" sap:label="Article"/>
                <Property Name="ItemText" Type="Edm.String" MaxLength="40" sap:label="Désignation"/>
                <Property Name="Quantity" Type="Edm.Decimal" Precision="13" Scale="3" sap:unit="BaseUnit" sap:label="Quantité" sap:filterable="false"/>
                <Property Name="BaseUnit" Type="Edm.String" MaxLength="3" sap:label="Unité" sap:semantics="unit-of-measure"/>
                <Property Name="Amount" Type="Edm.Decimal" Precision="12" Scale="3" sap:unit="Currency" sap:label="Montant" sap:filterable="false"/>
                <Property Name="Currency" Type="Edm.String" MaxLength="5" sap:label="Devise" sap:semantics="currency-code"/>
                <Property Name="LocalSupplierName" Type="Edm.String" MaxLength="80" sap:label="Fournisseur local"/>
                <Property Name="CreationDate" Type="Edm.DateTime" Precision="0" sap:display-format="Date" sap:label="Date de création"/>
                <Property Name="CreatedByUser" Type="Edm.String" MaxLength="12" sap:display-format="UpperCase" sap:label="Créée par"/>
                <Property Name="PettyCashStatus" Type="Edm.String" MaxLength="2" sap:display-format="UpperCase" sap:text="PettyCashStatusText" sap:label="Statut"/>
                <Property Name="PettyCashStatusText" Type="Edm.String" MaxLength="40" sap:label="Libellé statut" sap:filterable="false"/>
            </EntityType>

            <Association Name="assoc_WorklistSourceOption" sap:content-version="1">
                <End Type="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" Multiplicity="1" Role="FromRole_Worklist"/>
                <End Type="ZCRESASRC_CDS.ZC_ResaSourceOptionType" Multiplicity="*" Role="ToRole_SourceOption"/>
                <ReferentialConstraint>
                    <Principal Role="FromRole_Worklist">
                        <PropertyRef Name="PurchaseRequisition"/>
                        <PropertyRef Name="PurchaseRequisitionItem"/>
                    </Principal>
                    <Dependent Role="ToRole_SourceOption">
                        <PropertyRef Name="PurchaseRequisition"/>
                        <PropertyRef Name="PurchaseRequisitionItem"/>
                    </Dependent>
                </ReferentialConstraint>
            </Association>

            <EntityContainer Name="ZCRESASRC_CDS_Entities" m:IsDefaultEntityContainer="true" sap:supported-formats="atom json xlsx">
                <EntitySet Name="ZC_ResaPurReqWorklist" EntityType="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" sap:creatable="false" sap:updatable="true" sap:deletable="false" sap:searchable="true" sap:content-version="1"/>
                <EntitySet Name="ZC_ResaSourceOption" EntityType="ZCRESASRC_CDS.ZC_ResaSourceOptionType" sap:creatable="false" sap:updatable="false" sap:deletable="false" sap:content-version="1"/>
                <EntitySet Name="ZC_ResaPettyCashOrder" EntityType="ZCRESASRC_CDS.ZC_ResaPettyCashOrderType" sap:creatable="true" sap:updatable="false" sap:deletable="false" sap:searchable="true" sap:content-version="1"/>
                <AssociationSet Name="assoc_WorklistSourceOptionSet" Association="ZCRESASRC_CDS.assoc_WorklistSourceOption" sap:creatable="false" sap:updatable="false" sap:deletable="false" sap:content-version="1">
                    <End EntitySet="ZC_ResaPurReqWorklist" Role="FromRole_Worklist"/>
                    <End EntitySet="ZC_ResaSourceOption" Role="ToRole_SourceOption"/>
                </AssociationSet>

                <!-- Retenir une source pour un poste -->
                <FunctionImport Name="AssignSource" ReturnType="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" EntitySet="ZC_ResaPurReqWorklist" m:HttpMethod="POST" sap:action-for="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" sap:label="Retenir cette source">
                    <Parameter Name="PurchaseRequisition" Type="Edm.String" Mode="In" MaxLength="10"/>
                    <Parameter Name="PurchaseRequisitionItem" Type="Edm.String" Mode="In" MaxLength="5"/>
                    <Parameter Name="SourceOptionId" Type="Edm.String" Mode="In" MaxLength="70"/>
                </FunctionImport>

                <!-- Convertir le poste en commande d'achat avec la source retenue -->
                <FunctionImport Name="ConvertToPurchaseOrder" ReturnType="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" EntitySet="ZC_ResaPurReqWorklist" m:HttpMethod="POST" sap:action-for="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" sap:label="Convertir en commande d'achat">
                    <Parameter Name="PurchaseRequisition" Type="Edm.String" Mode="In" MaxLength="10"/>
                    <Parameter Name="PurchaseRequisitionItem" Type="Edm.String" Mode="In" MaxLength="5"/>
                    <Parameter Name="SourceOptionId" Type="Edm.String" Mode="In" MaxLength="70"/>
                </FunctionImport>

                <!-- Créer une commande petite caisse rattachée à la réservation -->
                <FunctionImport Name="CreatePettyCashOrder" ReturnType="ZCRESASRC_CDS.ZC_ResaPettyCashOrderType" EntitySet="ZC_ResaPettyCashOrder" m:HttpMethod="POST" sap:action-for="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" sap:label="Commande petite caisse">
                    <Parameter Name="PurchaseRequisition" Type="Edm.String" Mode="In" MaxLength="10"/>
                    <Parameter Name="PurchaseRequisitionItem" Type="Edm.String" Mode="In" MaxLength="5"/>
                    <Parameter Name="LocalSupplierName" Type="Edm.String" Mode="In" MaxLength="80"/>
                    <Parameter Name="Amount" Type="Edm.Decimal" Mode="In" Precision="12" Scale="3"/>
                </FunctionImport>

                <!-- Alternative 1 : créer un besoin interne (demande d'achat) -->
                <FunctionImport Name="CreatePurchaseRequisition" ReturnType="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" EntitySet="ZC_ResaPurReqWorklist" m:HttpMethod="POST" sap:label="Créer la demande d'achat">
                    <Parameter Name="Plant" Type="Edm.String" Mode="In" MaxLength="4"/>
                    <Parameter Name="Material" Type="Edm.String" Mode="In" MaxLength="40"/>
                    <Parameter Name="ItemText" Type="Edm.String" Mode="In" MaxLength="40"/>
                    <Parameter Name="Quantity" Type="Edm.Decimal" Mode="In" Precision="13" Scale="3"/>
                    <Parameter Name="RequestedDate" Type="Edm.DateTime" Mode="In" Precision="0"/>
                </FunctionImport>

                <!-- Alternative 2 : créer une commande de réapprovisionnement (DA + CA immédiate) -->
                <FunctionImport Name="CreateReplenishmentOrder" ReturnType="ZCRESASRC_CDS.ZC_ResaPurReqWorklistType" EntitySet="ZC_ResaPurReqWorklist" m:HttpMethod="POST" sap:label="Créer la commande de réapprovisionnement">
                    <Parameter Name="Plant" Type="Edm.String" Mode="In" MaxLength="4"/>
                    <Parameter Name="Material" Type="Edm.String" Mode="In" MaxLength="40"/>
                    <Parameter Name="ItemText" Type="Edm.String" Mode="In" MaxLength="40"/>
                    <Parameter Name="Quantity" Type="Edm.Decimal" Mode="In" Precision="13" Scale="3"/>
                    <Parameter Name="RequestedDate" Type="Edm.DateTime" Mode="In" Precision="0"/>
                    <Parameter Name="SourceType" Type="Edm.String" Mode="In" MaxLength="4"/>
                    <Parameter Name="SourceId" Type="Edm.String" Mode="In" MaxLength="10"/>
                </FunctionImport>
            </EntityContainer>

            <atom:link rel="self" href="./sap/ZCRESASRC_CDS/$metadata" xmlns:atom="http://www.w3.org/2005/Atom"/>
            <atom:link rel="latest-version" href="./sap/ZCRESASRC_CDS/$metadata" xmlns:atom="http://www.w3.org/2005/Atom"/>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>

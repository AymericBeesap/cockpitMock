{
  "name": "zlr.alt2source",
  "version": "1.0.0",
  "private": true,
  "description": "Alternative 2 - Détermination de la source pour les réservations",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2",
    "@sap/ux-ui5-tooling": "^1",
    "@ui5/cli": "^4"
  },
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#ResaSource-determineResa\"",
    "start-mock": "cd ../resacockpit && fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#ResaSource-determineResa\"",
    "start-standalone": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#ResaSource-determineResa\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "fiori verify && fiori deploy --config ui5-deploy.yaml",
    "deploy-test": "fiori deploy --config ui5-deploy.yaml --testMode true"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}

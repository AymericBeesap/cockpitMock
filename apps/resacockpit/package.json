{
  "name": "zovp.resacockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Cockpit réservations magasin - Overview Page",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2",
    "@sap/ux-ui5-tooling": "^1",
    "@ui5/cli": "^4"
  },
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#ResaCockpit-display\"",
    "start-launchpad": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#Shell-home\"",
    "start-mock":"fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#ResaCockpit-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "deploy": "fiori verify && fiori deploy --config ui5-deploy.yaml",
    "deploy-test": "fiori deploy --config ui5-deploy.yaml --testMode true"
  },
  "sapuxLayer": "CUSTOMER_BASE"
}

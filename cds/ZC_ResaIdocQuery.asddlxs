@Metadata.layer: #CORE

-- Annotations référencées par la carte card03_idoc du MO mais non définies
-- dans celui-ci (Chart#ErreursParMagasin, DataPoint#IDocsEnErreur).
@UI.chart: [ { qualifier:  'ErreursParMagasin',
               chartType:  #COLUMN,
               dimensions: [ 'SenderPartner' ],
               measures:   [ 'IDocErrorCount' ],
               dimensionAttributes: [ { dimension: 'SenderPartner', role: #CATEGORY } ],
               measureAttributes:   [ { measure: 'IDocErrorCount',
                                        role: #AXIS_1, asDataPoint: true } ] } ]

@UI.presentationVariant: [ { qualifier: 'ParMagasin',
                             sortOrder: [ { by: 'IDocErrorCount', direction: #DESC } ],
                             visualizations: [ { type: #AS_CHART,
                                                 qualifier: 'ErreursParMagasin' } ] } ]

annotate view ZC_ResaIdocQuery with
{
  -- Ajout : navigation de la carte d'intégration vers le monitoring des IDocs
  @UI.identification: [ { type: #WITH_INTENT_BASED_NAVIGATION,
                          semanticObject: 'ResaIdoc',
                          semanticObjectAction: 'monitor',
                          label: 'Monitoring des IDocs' } ]
  SenderPartner;

  @UI.dataPoint: { qualifier: 'IDocsEnErreur',
                   title:     'IDocs en erreur',
                   criticalityCalculation: {
                     improvementDirection:    #MINIMIZE,
                     toleranceRangeHighValue:  5,
                     deviationRangeHighValue: 15 } }
  IDocErrorCount;

  @UI.dataPoint: { qualifier:   'TauxIntegration',
                   title:       'Taux d''intégration',
                   targetValue: 98,
                   criticalityCalculation: {
                     improvementDirection:   #MAXIMIZE,
                     toleranceRangeLowValue: 95,
                     deviationRangeLowValue: 85 } }
  IntegrationRate;
}

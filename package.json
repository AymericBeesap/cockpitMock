{
  "name": "resa-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Détermination de la source d'approvisionnement (RAP, OData V4) et suivi des réservations magasin (SAP S/4HANA 2021 FPS02)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:launchpad": "npm run start-launchpad --workspace zlr.srcappro",
    "start:src": "npm run start-mock --workspace zlr.srcappro",
    "start:tracking": "npm run start-mock --workspace zlr.resatracking",
    "start:idoc": "npm run start-mock --workspace zlr.resaidoc",
    "mockdata": "node tools/generate-mockdata.js",
    "build": "npm run build --workspaces --if-present"
  }
}

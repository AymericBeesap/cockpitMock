{
  "name": "resa-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Cockpit de suivi des réservations magasin - Overview Page + List Reports (SAP S/4HANA 2021 FPS02)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:launchpad": "npm run start-launchpad --workspace zovp.resacockpit",
    "start:cockpit": "npm run start-mock --workspace zovp.resacockpit",
    "start:tracking": "npm run start-mock --workspace zlr.resatracking",
    "start:idoc": "npm run start-mock --workspace zlr.resaidoc",
    "mockdata": "node tools/generate-mockdata.js",
    "build": "npm run build --workspaces"
  }
}
